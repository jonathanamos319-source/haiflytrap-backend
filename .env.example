# ─── Server ───────────────────────────────────────────
# In cPanel, PORT is automatically provided by Passenger; default to 3001 locally
PORT=3001
NODE_ENV=production

# ─── Database (PostgreSQL) ────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# In cPanel PostgreSQL: host is usually localhost or 127.0.0.1
DATABASE_URL=postgresql://cpuser_dbuser:StrongPasswordHere@localhost:5432/cpuser_haiflytrap

# ─── Auth / JWT ───────────────────────────────────────
# Generate a strong 64-char secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_string_minimum_32_characters
JWT_EXPIRES_IN=7d
ADMIN_CREATION_SECRET=replace_with_secure_admin_creation_token

# ─── Google OAuth ─────────────────────────────────────
# Created in Google Cloud Console with authorized origins:
# https://haiflytrapng.com, https://www.haiflytrapng.com
GOOGLE_CLIENT_ID=454754192213-03st5m2atbee0fmgo32b3t75lov4oqq2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Frontend Origins ─────────────────────────────────
FRONTEND_URL=https://haiflytrapng.com

# ─── cPanel SMTP Email Configuration ──────────────────
# Standard cPanel email account settings (SSL on port 465)
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@haiflytrapng.com
SMTP_PASS=your_cpanel_email_password
MAIL_FROM="Haifly Trap" <support@haiflytrapng.com>

# ─── Web Push VAPID Keys ──────────────────────────────
VAPID_PUBLIC_KEY=BG3qS2NmwV9ZorBs2uwF98rpWn2eTlg7XoEuigT2QWVhSP5fAdfMYwd4zFFgDM17DkpsNGontjMOQfCwqwc9U-E
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@haiflytrapng.com

